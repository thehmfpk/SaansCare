# Copy to .env (never commit .env)
ML_API_KEY=change-me-long-random-string     # the Node backend sends this in the X-API-Key header; leave empty to disable
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
# MODELS_DIR=../models                       # optional: default is <repo>/models
# PREDICTION_LOG=logs/predictions.jsonl
